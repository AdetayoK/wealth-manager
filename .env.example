WEALTH_SESSION_SECRET=replace-with-at-least-32-random-characters
WEALTH_USER=owner
# Generate using: python -m app.security hash-password
WEALTH_PASSWORD_HASH=
WEALTH_DATABASE_URL=sqlite:///./data/wealth.db
WEALTH_SECURE_COOKIE=false
# Optional. AI assistant uses deterministic evidence cards if unset.
OPENAI_API_KEY=

# Optional external LLM. No financial data is transmitted without per-request consent.
WEALTH_LLM_MODEL=

# Optional US raw end-of-day close price provider; manual sync only.
ALPHAVANTAGE_API_KEY=
